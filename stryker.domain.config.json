{
  "$schema": "https://schema.stryker-mutator.io/stryker-config.json",
  "mutate": [
    "src/Domain/**/*.ts",
    "!src/Domain/**/Entity/*.ts",
    "!src/Domain/**/*.{test,spec}.ts"
  ],
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "reporters": ["progress", "clear-text", "html"],
  "concurrency": 2,
  "incremental": true,
  "ignoreStatic": true,
  "coverageAnalysis": "perTest",
  "incrementalFile": "reports/stryker-incremental-domain.json",
  "thresholds": {
    "break": 80
  }
}
