{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": ["./biome.shared.jsonc"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!dist", "!coverage", "!.stryker-tmp", "!node_modules"]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "useHookAtTopLevel": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/**",
        "!src/common/EnvVars.ts",
        "!src/index.ts",
        "!**/*.test.ts",
        "!**/*.spec.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.spec.ts", "vitest.setup.ts"],
      "javascript": {
        "globals": ["vi"]
      }
    },
    {
      "includes": ["load-tests/**"],
      "javascript": {
        "globals": ["__ENV", "__VU"]
      },
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "noProcessExit": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/DataProviders/Bug/BugRepository.ts",
        "src/DataProviders/MicroService/MicroServiceRepository.ts",
        "src/Domain/AccessControl/AccessHierarchyUseCase.ts",
        "src/Domain/Bug/UseCase/BugAssignmentUseCase.ts",
        "src/Domain/Bug/UseCase/BugLifecycleUseCase.ts",
        "src/Domain/Bug/UseCase/BugSubmissionUseCase.ts",
        "src/Domain/Bug/UseCase/BugSyncUseCase.ts",
        "src/Domain/User/UseCase/UserAuthUseCase.ts",
        "src/EntryPoints/AuthRouter.ts",
        "src/EntryPoints/BugRouter.ts",
        "src/EntryPoints/ConfigurationRouter.ts",
        "src/EntryPoints/ContainerLogsWebSocket.ts",
        "src/EntryPoints/RateLimits.ts",
        "src/EntryPoints/authorizationMatrix.test.ts",
        "src/Infrastructure/Health/HealthCheckCollector.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "info",
              "options": {
                "maxAllowedComplexity": 15
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/DataProviders/Bug/BugRepository.ts",
        "src/DataProviders/MicroService/MicroServiceRepository.ts",
        "src/Domain/AccessControl/AccessHierarchyUseCase.ts",
        "src/Domain/Bug/UseCase/BugLifecycleUseCase.ts",
        "src/Domain/Bug/UseCase/BugSubmissionUseCase.ts",
        "src/Domain/Bug/UseCase/BugSyncUseCase.ts",
        "src/EntryPoints/AuthRouter.ts",
        "src/EntryPoints/BugRouter.ts",
        "src/EntryPoints/ConfigurationRouter.ts",
        "src/EntryPoints/MfaRouter.ts",
        "src/EntryPoints/MicroServicesV1Router.ts",
        "src/EntryPoints/PermissionsV1Router.ts",
        "src/EntryPoints/RolePermissionsV1Router.ts",
        "src/EntryPoints/RolesV1Router.ts",
        "src/EntryPoints/UserRolesV1Router.ts",
        "src/EntryPoints/UsersV1Router.ts",
        "src/EntryPoints/index.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "info",
              "options": {
                "maxLines": 80,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/DataProviders/Activity/JournalReaderRepository.ts",
        "src/Domain/Activity/SecurityAlerts.ts",
        "src/Domain/Bug/Entity/BugFilter.ts",
        "src/Domain/Bug/UseCase/BugLifecycleUseCase.ts",
        "src/Domain/Bug/UseCase/BugSubmissionUseCase.ts",
        "src/Domain/Bug/UseCase/BugSyncUseCase.ts",
        "src/Domain/Configuration/Entity/Configuration.ts",
        "src/Domain/Configuration/UseCase/ScheduledConfigurationChangeUseCase.ts",
        "src/Domain/Core/Entity/ResponseModel.ts",
        "src/Domain/Countries/Entity/Country.ts",
        "src/Domain/Metrics/Entity/Metric.ts",
        "src/Domain/Mfa/UseCase/MfaResetUseCase.ts",
        "src/Domain/Mfa/UseCase/MfaSignInUseCase.ts",
        "src/Domain/Mfa/UseCase/UserMfaUseCase.ts",
        "src/Domain/MicroService/Entity/MicroService.ts",
        "src/Domain/MicroService/Entity/MicroServiceAuditEntry.ts",
        "src/Domain/MicroService/Entity/MicroServiceConfigItem.ts",
        "src/Domain/MicroService/Entity/MicroServiceDetailed.ts",
        "src/Domain/MicroService/Service/UptimeSummary.test.ts",
        "src/Domain/MicroService/UseCase/MicroServiceManagementUseCase.ts",
        "src/Domain/Permission/Entity/PermissionFilter.ts",
        "src/Domain/Role/Entity/RoleFilter.ts",
        "src/Domain/User/Entity/User.ts",
        "src/Domain/User/Entity/UserFilter.ts",
        "src/Domain/User/UseCase/UserAuthUseCase.ts",
        "src/Domain/User/UseCase/UserPasswordUseCase.ts",
        "src/EntryPoints/AuthRouter.ts",
        "src/EntryPoints/BugRouter.ts",
        "src/EntryPoints/RateLimits.test.ts",
        "src/EntryPoints/UsersV1Router.ts",
        "src/Infrastructure/GitHub/GitHubIssuesService.ts",
        "src/Infrastructure/database/Migrations/0018-usage-metrics.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useMaxParams": {
              "level": "info",
              "options": {
                "max": 4
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/CompositionRoot.ts",
        "src/DataProviders/Bug/BugRepository.ts",
        "src/DataProviders/MicroService/MicroServiceRepository.ts",
        "src/DataProviders/User/UserRepository.ts",
        "src/Domain/Bug/UseCase/BugLifecycleUseCase.ts",
        "src/EntryPoints/AuthRouter.ts",
        "src/EntryPoints/BugRouter.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "info",
              "options": {
                "maxLines": 400,
                "skipBlankLines": true
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/DataProviders/MicroService/HealthLogStatistics.integration.test.ts",
        "src/DataProviders/Permission/PermissionRepository.ts",
        "src/DataProviders/User/UserRepository.ts",
        "src/Domain/Bug/UseCase/BugSubmissionUseCase.ts",
        "src/Domain/MicroService/Service/UptimeSummary.ts",
        "src/Domain/User/UseCase/UserAuthUseCase.ts",
        "src/EntryPoints/AuthRouter.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNestedTernary": "info"
          }
        }
      }
    }
  ]
}
