# Variables read by the service (src/common/EnvVars.ts and variamos-security).
# Copy this file to env/development.env, which git ignores, and fill it in.
# In production, every value comes from the container.

NODE_ENV=development
PORT=

DB_USER=
DB_HOST=
DB_PASSWORD=
DB_DATABASE=
DB_PORT=
DB_SSL=
DB_SCHEMA=

CORS_ALLOWED_ORIGINS_PATTERNS=
COOKIE_SECRET=
COOKIE_PATH=
COOKIE_EXP_IN_MS=
COOKIE_DOMAIN=
SECURE_COOKIE=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
HOME_REDIRECT_URI=
LOGIN_REDIRECT_URI=
ADMIN_HOME_URI=
API_BASE_URL=

PASSWORD_RESET_EXPIRY_IN_MS=
BCRYPT_SALT_ROUNDS=
# 32 random bytes in base64 each: openssl rand -base64 32
MFA_ENCRYPTION_KEY=
CONFIG_ENCRYPTION_KEY=

VARIAMOS_PRIVATE_KEY_PATH=./jwtRS256.key
VARIAMOS_PUBLIC_KEY_PATH=./jwtRS256.key.pub
VARIAMOS_JWT_EXP_IN_SECONDS=

DOCKER_SOCKET_PATH=
HEALTH_CHECK_INTERVAL_MS=

# Left blank, emails are written to the console
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

GITHUB_TOKEN=
GITHUB_MANAGED_REPOS=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

NOTIFICATION_SERVICE_URL=
NOTIFICATION_INTERNAL_TOKEN=
