// Configuration Biome commune aux trois dépôts du module d'administration
// (variamos_ms_admin, variamos_ms_notifications, VariaMosAdmin), reprise par
// "extends" dans chaque biome.json. Les trois copies doivent rester identiques.
// Règles : "error" bloque, "info" signale sans bloquer (EV-100, B2), "off" est
// justifié sur la ligne. Le biome.json du dépôt ne garde que ce qui lui est propre.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "plugins": [
    "./rules/no-trivial-assertion.grit",
    "./rules/called-without-arguments.grit"
  ],
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAccessKey": "error",
        "noAmbiguousAnchorText": "error",
        "noAriaHiddenOnFocusable": "error",
        "noAriaUnsupportedElements": "error",
        "noAutofocus": "error",
        "noDistractingElements": "error",
        "noInteractiveElementToNoninteractiveRole": "error",
        "noLabelWithoutControl": "error",
        "noNoninteractiveElementInteractions": "error",
        "noNoninteractiveElementToInteractiveRole": "error",
        "noNoninteractiveTabindex": "error",
        "noPositiveTabindex": "error",
        "noRedundantAlt": "error",
        "noRedundantRoles": "error",
        "noStaticElementInteractions": "error",
        "noSvgWithoutTitle": "error",
        "useAltText": "error",
        "useAnchorContent": "error",
        "useAriaActivedescendantWithTabindex": "error",
        "useAriaPropsForRole": "error",
        "useAriaPropsSupportedByRole": "error",
        "useButtonType": "error",
        "useFocusableInteractive": "error",
        "useHtmlLang": "error",
        "useIframeTitle": "error",
        "useKeyWithClickEvents": "error",
        "useKeyWithMouseEvents": "error",
        "useMediaCaption": "error",
        "useSemanticElements": "error",
        "useValidAnchor": "error",
        "useValidAriaProps": "error",
        "useValidAriaRole": "error",
        "useValidAriaValues": "error",
        "useValidAutocomplete": "error",
        "useValidLang": "error"
      },
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "noArguments": "error",
        "noBannedTypes": "error",
        "noCommaOperator": "error",
        "noEmptyTypeParameters": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 80,
            "skipBlankLines": true
          }
        },
        "noExcessiveNestedCallbacks": "error",
        "noExcessiveNestedTestSuites": "error",
        "noExtraBooleanCast": "error",
        "noFlatMapIdentity": "error",
        "noImplicitCoercions": "info",
        "noPlaywrightUselessAwait": "error",
        "noRedundantDefaultExport": "error",
        "noThisInStatic": "error",
        "noUnnecessaryTemplateExpression": "error",
        "noUselessCatch": "error",
        "noUselessCatchBinding": "error",
        "noUselessConstructor": "error",
        "noUselessContinue": "error",
        "noUselessEmptyExport": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessFragments": "error",
        "noUselessLabel": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessRename": "error",
        "noUselessReturn": "error",
        "noUselessStringConcat": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "noUselessUndefinedInitialization": "error",
        "useArrayFind": "error",
        "useArraySome": "error",
        "useArrowFunction": "error",
        "useDateNow": "error",
        "useFlatMap": "error",
        "useIndexOf": "error",
        "useLiteralKeys": "error",
        "useMathMinMax": "error",
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 4
          }
        },
        "useNumericLiterals": "error",
        "useOptionalChain": "error",
        "useRegexLiterals": "error",
        "useRegexpTest": "error",
        "useSimpleNumberKeys": "error",
        "useSimplifiedLogicExpression": "off" /* la forme proposée n'est pas plus lisible */,
        "useWhile": "error"
      },
      "correctness": {
        "noChildrenProp": "error",
        "noConstAssign": "error",
        "noConstantCondition": "error",
        "noConstantMathMinMaxClamp": "error",
        "noConstructorReturn": "error",
        "noDuplicateArgumentNames": "error",
        "noDuplicateAttributes": "error",
        "noDuplicateEnumValueNames": "error",
        "noDuplicateFieldDefinitionNames": "error",
        "noDuplicateInputFieldNames": "error",
        "noDuplicateVariableNames": "error",
        "noEmptyCharacterClassInRegex": "error",
        "noEmptyPattern": "error",
        "noGlobalDirnameFilename": "error",
        "noGlobalObjectCalls": "error",
        "noInnerDeclarations": "error",
        "noInvalidBuiltinInstantiation": "error",
        "noInvalidConstructorSuper": "error",
        "noInvalidUseBeforeDeclaration": "error",
        "noJsxNamespace": "error",
        "noNestedComponentDefinitions": "error",
        "noNonoctalDecimalEscape": "error",
        "noPlaywrightMissingAwait": "error",
        "noPrecisionLoss": "error",
        "noPrivateImports": "error",
        "noProcessGlobal": "off" /* process est global sous Node ; l'import n'apporte rien */,
        "noReactPropAssignments": "error",
        "noRenderReturnValue": "error",
        "noSelfAssign": "error",
        "noSetterReturn": "error",
        "noStringCaseMismatch": "error",
        "noSwitchDeclarations": "error",
        "noUndeclaredDependencies": "error",
        "noUndeclaredVariables": "error",
        "noUnreachable": "error",
        "noUnreachableSuper": "error",
        "noUnsafeFinally": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedInstantiation": "off" /* new Intl.DateTimeFormat() sert à valider un fuseau */,
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error",
        "noVoidElementsWithChildren": "error",
        "noVoidTypeReturn": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "useIsNan": "error",
        "useJsonImportAttributes": "error",
        "useJsxKeyInIterable": "error",
        "useLoneAnonymousOperation": "error",
        "useParseIntRadix": "error",
        "usePlaywrightValidDescribeCallback": "error",
        "useReactAsyncServerFunction": "error",
        "useSingleJsDocAsterisk": "error",
        "useUniqueElementIds": "info",
        "useValidForDirection": "error",
        "useValidTypeof": "error",
        "useYield": "error"
      },
      "nursery": {
        "noAccidentalBitwiseOperators": "error",
        "noArgumentsCallerOrCallee": "error",
        "noArraySortForMinMax": "error",
        "noBaseToString": "error",
        "noBooleanSortComparator": "error",
        "noConsoleSpaces": "error",
        "noDoubleComparison": "error",
        "noDuplicateMapKeys": "error",
        "noEagerArrayMethodsInLoops": "error",
        "noExcessiveStatementsPerFunction": "off" /* doublon de noExcessiveLinesPerFunction */,
        "noExtendNative": "error",
        "noFloatingPromises": "error",
        "noImpliedEval": "error",
        "noInvalidThis": "error",
        "noMagicArrayFlatDepth": "error",
        "noMeaninglessVoidOperator": "error",
        "noMisleadingReturnType": "off" /* signale string sur une fonction qui rend des littéraux */,
        "noMisplacedListElements": "error",
        "noMisusedPromises": "error",
        "noNegationInEqualityCheck": "error",
        "noNestedSwitch": "error",
        "noNestedTemplateLiterals": "error",
        "noNewRequire": "error",
        "noObjectConstructor": "error",
        "noOctal": "error",
        "noPathConcat": "error",
        "noProcessExit": "error",
        "noPromiseExecutorReturn": "error",
        "noReactObjectTypeAsDefaultProp": "error",
        "noReturnArrayPush": "error",
        "noReturnInFinally": "error",
        "noSelfImport": "error",
        "noShortTimeValues": "error",
        "noThisOutsideOfClass": "error",
        "noUnmodifiedLoopCondition": "error",
        "noUnreadableForOfExpression": "error",
        "noUnreadableIife": "error",
        "noUnsafeIframeSandbox": "error",
        "noUnsafePlusOperands": "error",
        "noUnsafeReturn": "error",
        "noUnsafeTypeAssertion": "info",
        "noUnsafeUnaryMinus": "error",
        "noUselessAssignment": "error",
        "noUselessCall": "error",
        "noUselessDateGetTime": "error",
        "noUselessRecursion": "error",
        "noUselessSplice": "error",
        "noUselessTypeConversion": "error",
        "noXorAsExponentiation": "error",
        "noZeroFractions": "error",
        "useAwaitThenable": "off" /* faux positifs : await act(...), clients dockerode */,
        "useBetterDomTraversing": "error",
        "useBigintLiterals": "error",
        "useBlockStatementOverIife": "error",
        "useCapitalizedConstructors": "off" /* faux positifs : ENUM() de Sequelize, SetMetadata() de NestJS */,
        "useConsistentJsonFileRead": "error",
        "useControlLabel": "error",
        "useDisposables": "error",
        "useExhaustiveSwitchCases": "error",
        "useExpectToContain": "error",
        "useFlatMathMinMax": "error",
        "useIncludes": "error",
        "useIteratorZip": "error",
        "useMathAbs": "error",
        "useMathTrunc": "off" /* | 0 ramène aussi sur 32 bits, ce que Math.trunc ne fait pas */,
        "useModernMathApis": "error",
        "useNullishCoalescing": "info",
        "usePromiseRejectErrors": "error",
        "useReactNamingConvention": "error",
        "useRegexpExec": "error",
        "useSimplifiedBooleanReturn": "error",
        "useStringStartsEndsWith": "error",
        "useUnaryMinus": "error",
        "useValidTestTitle": "error",
        "useWhileLoopCondition": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noAwaitInLoops": "info",
        "noDelete": "error",
        "noDynamicNamespaceImportAccess": "error",
        "noJsxPropsBind": "off" /* les fonctions fléchées en props sont l'usage React courant */,
        "useDomNodeTextContent": "error"
      },
      "security": {
        "noBlankTarget": "error",
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error",
        "noScriptUrl": "error",
        "noSecrets": "off" /* doublon de trufflehog en CI, faux positifs nombreux */,
        "useIframeSandbox": "info"
      },
      "style": {
        "noDoneCallback": "error",
        "noExcessiveClassesPerFile": "off" /* les erreurs du domaine sont groupées par fichier */,
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 400,
            "skipBlankLines": true
          }
        },
        "noInferrableTypes": "error",
        "noMultiAssign": "error",
        "noNamespace": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noPlaywrightElementHandle": "error",
        "noPlaywrightEval": "error",
        "noSubstr": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error",
        "useAtIndex": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": "error",
        "useConsistentBuiltinInstantiation": "error",
        "useConsistentEnumValueType": "error",
        "useConst": "error",
        "useDefaultParameterLast": "error",
        "useDefaultSwitchClause": "off" /* un default masque le cas oublié que useExhaustiveSwitchCases signale */,
        "useEnumInitializers": "error",
        "useErrorCause": "error",
        "useExplicitLengthCheck": "error",
        "useExponentiationOperator": "error",
        "useExportType": "error",
        "useForOf": "error",
        "useFragmentSyntax": "error",
        "useGlobalThis": "off" /* window est plus lisible dans une application web */,
        "useGroupedAccessorPairs": "error",
        "useLiteralEnumMembers": "error",
        "useNodeAssertStrict": "error",
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useObjectSpread": "error",
        "useReduceTypeParameter": "error",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "error",
        "useShorthandFunctionType": "error",
        "useSingleVarDeclarator": "error",
        "useSpreadOverApply": "error",
        "useSymbolDescription": "error",
        "useTemplate": "error",
        "useTestHooksInOrder": "error",
        "useTestHooksOnTop": "error",
        "useThisInClassMethods": "off" /* contraire aux classes injectées (dépôts, cas d'usage) */,
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useTrimStartEnd": "error",
        "useUnifiedTypeSignatures": "error"
      },
      "suspicious": {
        "noAlert": "error",
        "noApproximativeNumericConstant": "error",
        "noArrayIndexKey": "error",
        "noAssignInExpressions": "error",
        "noAsyncPromiseExecutor": "error",
        "noCatchAssign": "error",
        "noClassAssign": "error",
        "noCommentText": "error",
        "noCompareNegZero": "error",
        "noConditionalExpect": "error",
        "noConfusingLabels": "error",
        "noConfusingVoidType": "error",
        "noConsole": "error",
        "noConstEnum": "error",
        "noConstantBinaryExpressions": "error",
        "noControlCharactersInRegex": "error",
        "noDebugger": "error",
        "noDeprecatedImports": "error",
        "noDoubleEquals": "error",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateElseIf": "error",
        "noDuplicateEnumValues": "error",
        "noDuplicateJsxProps": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noDuplicateTestHooks": "error",
        "noDuplicatedSpreadProps": "error",
        "noEmptyBlockStatements": "error",
        "noEmptyInterface": "error",
        "noEmptyObjectKeys": "error",
        "noEqualsToNull": "error",
        "noEvolvingTypes": "error",
        "noExplicitAny": "error",
        "noExportsInTest": "error",
        "noExtraNonNullAssertion": "error",
        "noFallthroughSwitchClause": "error",
        "noFocusedTests": "error",
        "noForIn": "error",
        "noFunctionAssign": "error",
        "noGlobalAssign": "error",
        "noGlobalIsFinite": "error",
        "noGlobalIsNan": "error",
        "noIdenticalTestTitle": "error",
        "noImplicitAnyLet": "error",
        "noImportAssign": "error",
        "noImportCycles": "error",
        "noIrregularWhitespace": "error",
        "noJsxLeakedDollar": "error",
        "noLabelVar": "error",
        "noLeakedRender": "info",
        "noLoopFunc": "error",
        "noMisleadingCharacterClass": "error",
        "noMisleadingInstantiator": "error",
        "noMisplacedAssertion": "off" /* refuse les assertions des fonctions d'aide de test */,
        "noMisrefactoredShorthandAssign": "error",
        "noNestedPromises": "error",
        "noNonNullAssertedOptionalChain": "error",
        "noOctalEscape": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noPlaywrightForceOption": "error",
        "noPlaywrightNetworkidle": "error",
        "noPlaywrightPagePause": "error",
        "noPlaywrightWaitForNavigation": "error",
        "noPlaywrightWaitForTimeout": "error",
        "noProto": "error",
        "noPrototypeBuiltins": "error",
        "noReactForwardRef": "error",
        "noReactSpecificProps": "off" /* pour Solid et Preact : interdit className */,
        "noReactStringRefs": "error",
        "noRedeclare": "error",
        "noRedundantUseStrict": "error",
        "noReturnAssign": "error",
        "noSelfCompare": "error",
        "noShadow": "error",
        "noSkippedTests": "error",
        "noSparseArray": "error",
        "noSuspiciousSemicolonInJsx": "error",
        "noTemplateCurlyInString": "error",
        "noThenProperty": "error",
        "noTsIgnore": "error",
        "noUnassignedVariables": "error",
        "noUnknownAttribute": "error",
        "noUnnecessaryConditions": "info",
        "noUnsafeDeclarationMerging": "error",
        "noUnsafeNegation": "error",
        "noUnusedExpressions": "error",
        "noUselessEscapeInString": "error",
        "noUselessRegexBackrefs": "error",
        "noVar": "error",
        "noWith": "error",
        "useAdjacentOverloadSignatures": "error",
        "useArraySortCompare": "error",
        "useAwait": "info",
        "useDefaultSwitchClauseLast": "error",
        "useDeprecatedDate": "error",
        "useErrorMessage": "error",
        "useExpect": "error",
        "useGetterReturn": "error",
        "useGuardForIn": "error",
        "useIsArray": "error",
        "useIterableCallbackReturn": "error",
        "useNamespaceKeyword": "error",
        "useNumberToFixedDigitsArgument": "error",
        "useStaticResponseMethods": "error",
        "useStrictMode": "off" /* fichiers de configuration CommonJS */
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.md", "**/*.yml", "**/*.yaml", "**/*.grit"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*-spec.ts",
        "!**/tests/**",
        "!**/test/**",
        "!**/test-support/**",
        "!**/setupTests.ts",
        "!**/vitest.setup.ts"
      ],
      "plugins": ["./rules/no-double-assertion.grit"]
    },
    {
      "includes": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/*-spec.ts",
        "**/tests/**",
        "**/test/**",
        "**/test-support/**",
        "**/setupTests.ts",
        "**/vitest.setup.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off",
            "noConsole": "off",
            "noShadow": "off",
            "useAwait": "off"
          },
          "nursery": {
            "noThisOutsideOfClass": "off",
            "noUnsafeTypeAssertion": "off"
          },
          "correctness": {
            "noGlobalDirnameFilename": "off"
          }
        }
      }
    },
    {
      "includes": [
        "scripts/**",
        "load-tests/**",
        "build.ts",
        "**/*.config.*",
        "**/*.cjs",
        "**/.dependency-cruiser.*"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "nursery": {
            "noProcessExit": "off",
            "noUnsafeReturn": "off"
          }
        }
      }
    }
  ]
}
