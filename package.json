{
  "name": "variamos-ms-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npx tsx build.ts",
    "lint": "biome check src/",
    "lint:diff": "biome check --changed src/",
    "lint:diff:fix": "biome check --write --changed src/",
    "fix:all": "biome check --write src/",
    "start": "node ./dist/index.js --env=production",
    "dev": "npx tsx watch src/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run src/Domain",
    "test:integration": "vitest run src/EntryPoints",
    "test:coverage": "vitest run --coverage",
    "stryker:domain": "stryker run stryker.domain.config.json",
    "stryker:entrypoints": "stryker run stryker.entrypoints.config.json",
    "prepare": "husky",
    "check-arch": "dependency-cruiser --config .dependency-cruiser.cjs src/",
    "typecheck": "tsc --noEmit",
    "find-deadcode": "knip"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@variamosple/variamos-security": "^0.0.15",
    "axios": "^1.7.7",
    "bcrypt": "^6.0.0",
    "cookie": "^2.0.1",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "dockerode": "^5.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "jet-logger": "^2.2.3",
    "module-alias": "^2.2.3",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "sequelize": "^6.37.8",
    "ts-command-line-args": "^2.5.1",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.0.5",
    "@biomejs/biome": "^1.9.4",
    "cspell": "^10.0.1",
    "dependency-cruiser": "^18.1.1",
    "fs-extra": "^11.4.0",
    "husky": "^9.1.7",
    "vitest-mock-extended": "^2.0.1",
    "knip": "^6.24.0",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "uuid": "^14.0.1",
    "qs": "^6.15.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "cpu-features@0.0.10": true,
    "protobufjs@7.6.5": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true,
    "@biomejs/biome@1.9.4": true
  }
}
