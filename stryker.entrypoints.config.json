{
  "$schema": "https://schema.stryker-mutator.io/stryker-config.json",
  "mutate": [
    "src/EntryPoints/**/*.ts",
    "!src/EntryPoints/**/*.{test,spec}.ts"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "reporters": ["progress", "clear-text", "html"],
  "concurrency": 2,
  "incremental": true,
  "ignoreStatic": true,
  "coverageAnalysis": "perTest",
  "incrementalFile": "reports/stryker-incremental-entrypoints.json",
  "thresholds": {
    "break": 60
  }
}
