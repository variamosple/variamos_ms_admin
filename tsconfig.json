{
  // Options: https://aka.ms/tsconfig
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,
    "module": "node16",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "./",
    "strict": true,
    "moduleResolution": "node16",
    // Resolve package.json "imports" (#src/*) to the sources in src/ at
    // typecheck time; the emitted dist/ keeps the #src/ specifiers.
    "customConditions": ["variamos-dev"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": false,
    "types": ["vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "spec/**/*.ts",
    "build.ts",
    "vitest.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": ["src/public/"]
}
